        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "missing_artifacts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Artifacts",
      "type": "array"
    },
    "cases": {
      "additionalProperties": true,
      "default": {},
      "title": "Cases",
      "type": "object"
    },
    "failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Failure"
      },
      "title": "Failures",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {},
      "title": "Metrics",
      "type": "object"
    },
    "checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "verdict": {
      "anyOf": [
        {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    },
    "verdict_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict Reason"
    },
    "defects": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Defects",
      "type": "array"
    },
    "build": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build"
    },
    "link": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Link"
    }
  },
  "required": [
    "plan_id",
    "state"
  ],
  "title": "TestRun",
  "type": "object"
}
