        "message": {
          "title": "Message",
          "type": "string"
        },
        "category": {
          "enum": [
            "product",
            "environment",
            "scheduling",
            "flaky",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        }
      },
      "required": [
        "case",
        "message",
        "category"
      ],
      "title": "Failure",
      "type": "object"
    }
